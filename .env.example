# Required: choose a unique password with at least 12 characters.
DASHBOARD_PASSWORD=
PORT=8081
BIND_ADDRESS=0.0.0.0
TZ=Asia/Singapore
# Set true for HTTPS access; leave false for plain HTTP on a trusted LAN.
COOKIE_SECURE=false
# Create a NEW bot with @BotFather
TELEGRAM_BOT_TOKEN=
# Numeric ID of your personal Telegram account, not your bot username.
TELEGRAM_ALLOWED_USER_ID=
# Optional: the negative numeric ID from /whoami@YourBot in your group.
TELEGRAM_ALLOWED_GROUP_ID=
# Automatic messages: auto = configured group, otherwise private. Override with group or private.
TELEGRAM_NOTIFICATION_CHAT=auto
# Optional forum topic for group automatic messages (0 = general chat).
TELEGRAM_NOTIFICATION_THREAD_ID=0
# Uncomment after configuring both Telegram variables.
COMPOSE_PROFILES=telegram
