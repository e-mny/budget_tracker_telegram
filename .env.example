# Required: choose a unique password with at least 12 characters.
DASHBOARD_PASSWORD=
PORT=8081
BIND_ADDRESS=0.0.0.0
TZ=Asia/Singapore
# Set true for HTTPS access; leave false for plain HTTP on a trusted LAN.
COOKIE_SECURE=false
# Create a NEW bot with @BotFather
TELEGRAM_BOT_TOKEN=
# Numeric ID of your personal Telegram account, not your bot username.
TELEGRAM_ALLOWED_USER_ID=
# Uncomment after configuring both Telegram variables.
COMPOSE_PROFILES=telegram
