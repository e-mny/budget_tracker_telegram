# Merge these into the server's existing .env. Preserve its password and Telegram settings.
COMPOSE_PROJECT_NAME=money-tracker
IMAGE_REPOSITORY=ghcr.io/e-mny/budget_tracker_telegram
IMAGE_TAG=latest
# Confirm the actual volume name with docker inspect before switching deployments.
MONEY_DATA_VOLUME=money-tracker_money_data
# Keep COMPOSE_PROFILES=telegram when using the bot.
